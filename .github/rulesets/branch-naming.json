{
  "name": "branch-naming",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": [
        "refs/heads/main",
        "refs/heads/develop",
        "refs/heads/feature/**/*",
        "refs/heads/bugfix/**/*",
        "refs/heads/refactor/**/*",
        "refs/heads/docs/**/*",
        "refs/heads/release/**/*"
      ]
    }
  },
  "rules": [
    {"type": "creation"}
  ]
}
